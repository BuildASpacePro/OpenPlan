---
import BloombergDashboard from '../components/BloombergDashboard.jsx';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Constellation Control - Bloomberg Terminal</title>
    <style>
      /* Minimal critical CSS for instant load */
      body {
        margin: 0;
        padding: 0;
        background-color: #000000;
        color: #e0e0e0;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
      }
    </style>
  </head>
  <body>
    <BloombergDashboard client:only="react" />

    <script>
      // Check if initial setup is required
      async function checkSetupStatus() {
        try {
          const response = await fetch('http://localhost:3000/api/auth/setup-status');
          const data = await response.json();

          if (data.setup_required) {
            window.location.href = '/setup';
            return false;
          }

          return true;
        } catch (error) {
          console.error('Error checking setup status:', error);
          return true;
        }
      }

      // Check setup on page load
      checkSetupStatus();
    </script>
  </body>
</html>